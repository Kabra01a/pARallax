# Copy to `segmentation/.env` and edit. Never commit the real .env.

# --- Model ---
# FAST tier (320x320) - keeps the press-and-hold gesture responsive
#   u2net                  ~750 ms on an M-series CPU  <- default
#   silueta                same speed, 43 MB
#
# QUALITY tier (1024x1024) - visibly better hair, fur, thin structures,
# but an order of magnitude slower on CPU. Measure before choosing.
#   birefnet-general-lite  ~10-12 s
#   birefnet-general       ~23 s
#   birefnet-portrait      tuned for people
MODEL_NAME=u2net

# --- Inference ---
# Morphological cleanup of the mask. Cheap, usually worth it.
POST_PROCESS_MASK=true

# Edge refinement. Noticeably better on hair, but slow on CPU. Measure first.
ALPHA_MATTING=false
ALPHA_MATTING_FG_THRESHOLD=240
ALPHA_MATTING_BG_THRESHOLD=10
ALPHA_MATTING_ERODE_SIZE=10

# --- Server ---
HOST=0.0.0.0
PORT=8081
DEBUG=false

# --- Execution providers ---
# auto = prefer CoreML on macOS / CUDA on Linux, else CPU. Or "cpu", or an
# explicit comma-separated ONNX Runtime provider list.
PROVIDERS=auto

# Do NOT set this to ALL or CPUAndNeuralEngine unless you want to find out why.
# Allowing the Neural Engine makes CoreML run ANECompilerService, which on
# BiRefNet burned 48 min of CPU and ~11 GB of swap without finishing.
COREML_COMPUTE_UNITS=CPUAndGPU
COREML_MODEL_FORMAT=MLProgram
