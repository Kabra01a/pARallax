# Copy to `server/.env` and edit. Never commit the real .env.

# --- Segmentation service ---
# HTTP endpoint that takes an image and returns a grayscale saliency mask.
# The upstream community endpoint is no longer reliable - run your own.
SEGMENTATION_SERVICE_URL=http://localhost:8081
SEGMENTATION_TIMEOUT=30

# --- Local server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEBUG=false

# Narrow this from "*" once you are past local development.
CORS_ORIGINS=*

# Dump intermediate images to server/tmp/ for debugging.
SAVE_DEBUG_IMAGES=false

# --- Image pipeline ---
MAX_VIEW_SIZE=700
MAX_SCREENSHOT_SIZE=400

# --- Paste target ---
# gimp       free, cross-platform, via the Script-Fu server (default)
# photoshop  macOS only, via AppleScript
PASTE_TARGET=gimp

# --- Paste sizing ---
# Cutouts arrive at camera resolution. A 12MP phone photo is ~3000x4000, which
# on a 1920x1080 canvas overflows every edge. Scale to at most this fraction of
# the canvas in both dimensions.
PASTE_MAX_FRACTION=0.4

# Allow enlarging cutouts smaller than the target. Off by default - upscaling a
# small crop only magnifies its softness.
PASTE_ALLOW_UPSCALE=false

# --- GIMP ---
# Enable the server in GIMP: Filters > Script-Fu > Start Server.
# It has NO authentication - keep it on localhost, never expose it.
GIMP_HOST=127.0.0.1
GIMP_PORT=10008
GIMP_TIMEOUT=30

# --- Photoshop (macOS) ---
# Leave blank to auto-detect the running Photoshop version.
PHOTOSHOP_APP_NAME=
PHOTOSHOP_DOC_WIDTH=2121
PHOTOSHOP_DOC_HEIGHT=1280
SCREEN_PIXEL_DENSITY=2
